+    def _select_destination_folder(self, connection, folder_name):
+        """Select a normalized Kerio mailbox and return the successful name."""
+        encoded = encode_imap_folder_name(folder_name)
+        name_variants = [
+            encoded,
+            quote_imap_mailbox(encoded),
+            folder_name,
+            quote_imap_mailbox(folder_name),
+        ]
+        select_names = []
+        for name in name_variants:
+            if name not in select_names:
+                select_names.append(name)
+
+        last_result = None
+        last_data = None
+        for select_name in select_names:
+            try:
+                result, data = connection.select(select_name, readonly=True)
+                last_result, last_data = result, data
+                if str(result).upper() == "OK":
+                    return result, data, select_name
+            except Exception as error:
+                last_result, last_data = "ERROR", str(error)
+        return last_result, last_data, None
+
+    def _append_destination_message(self, connection, mailbox, flags, internal_date, raw_message):
+        """APPEND one message and reject IMAP NO/BAD responses as errors."""
+        append_result, append_data = connection.append(
+            mailbox,
+            flags,
+            internal_date,
+            raw_message,
+        )
+        if str(append_result).upper() != "OK":
+            raise RuntimeError(
+                f"APPEND вернул {append_result}: "
+                f"{format_imap_response(append_data)}"
+            )
+        return append_result, append_data
