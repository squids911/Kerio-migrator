+def format_imap_response(response_data):
+    """Format a short IMAP response for diagnostics without huge payloads."""
+    if isinstance(response_data, bytes):
+        return response_data.decode("utf-8", errors="replace")[:1000]
+    if isinstance(response_data, (list, tuple)):
+        return "; ".join(format_imap_response(item) for item in response_data)[:1000]
+    return str(response_data)[:1000]
+
